# ローカルで試す場合はこのファイルを .env にコピーして値を入れる。
# GitHub Actions では下記をリポジトリ Secrets に登録する(.env は不要)。

# --- Instagram API(Instagramログイン方式) ---
# IG_USER_ID は不要(APIが "me" で自分の投稿を返す)。トークンだけでよい。
IG_ACCESS_TOKEN=IGAA...アクセストークン...

# --- Shopify Admin API(Dev Dashboard アプリ / client credentials) ---
SHOPIFY_STORE=so-thing.myshopify.com
# Dev Dashboard アプリの「資格情報」にあるクライアントID・シークレット
SHOPIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 省略すると先頭のブログを自動選択。特定ブログに入れたい場合のみ指定。
# SHOPIFY_BLOG_ID=123456789

# --- 任意 ---
# 1回の実行で取り込む最大件数
MAX_POSTS=10
# true にすると Shopify へ書き込まず動作内容だけ表示
DRY_RUN=false
# true にすると下書きではなく即時公開(既定は下書き)
PUBLISH=false
